# Google Cloud OAuth 2.0 credentials, from a "Desktop app" client.
# console.cloud.google.com -> APIs & Services -> Credentials -> Create credentials
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# Filled in automatically by `npm run auth` — do not edit by hand.
YT_REFRESH_TOKEN=

# Optional. Leave blank to upload to the channel the auth flow was run against.
YT_CHANNEL_ID=

# 22 = People & Blogs, 27 = Education, 24 = Entertainment
YT_CATEGORY_ID=27

# private | unlisted | public
# NOTE: an unverified API project force-locks every upload to private
# regardless of this value. It only takes effect after the compliance audit.
YT_PRIVACY=public
